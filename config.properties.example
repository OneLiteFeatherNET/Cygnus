# Cygnus game configuration.
#
# Copy this file to the working directory of the service as "config.properties".
# That is the directory named by -Dservice.working.dir (CloudNet sets it per
# service), or the directory the process was started in. Without the file, and
# for every entry left out of it, the defaults below are used.
#
# A value that cannot be parsed as a number is logged and replaced by the default.
# A value outside the ranges noted below is rejected outright and the service
# refuses to start.

# --- Players ---------------------------------------------------------------

# Players needed before the lobby countdown starts.
minPlayers=2

# Players allowed on the service. Everyone beyond this is kicked on login.
maxPlayers=13

# --- Timing (seconds) ------------------------------------------------------

# Lobby countdown. Has to be greater than 11, the point at which the countdown
# can no longer be shortened by a force start.
lobbyTime=30

# Length of a round. When it runs out, the round ends.
gameTime=900

# --- Teams -----------------------------------------------------------------

# Players hunting. At least 1.
slenderTeamSize=1

# Players being hunted. At least slenderTeamSize + 1.
survivorTeamSize=12

# --- Sentry ----------------------------------------------------------------

# DSN of the Sentry project errors are reported to. Leave it out to keep error
# reporting off entirely: no client is created and nothing is sent anywhere.
#sentryDsn=https://publickey@sentry.example.com/1

# The Sentry environment (for example staging) comes from the environment variable SENTRY_ENVIRONMENT.
# Unset keeps Sentry's default, production.

# --- ResourcePack ----------------------------------------------------------

# Location the client downloads the pack from. Leave it out to disable the
# ResourcePack feature. With it set, the pack is mandatory: a client that
# declines it or fails to load it is kicked.
#resourcePackUrl=https://cdn.example.com/cygnus.zip

# SHA-1 checksum of the pack behind resourcePackUrl, 40 hexadecimal characters.
#
# State it in production. It is what lets a client reuse the pack it already has
# instead of downloading it again on every join.
#
# Leaving it out is a test-only convenience: the server then downloads the pack
# once on the first join and hashes it itself, which delays that join and costs
# the download on every restart.
#resourcePackSha1=0000000000000000000000000000000000000000

# --- Page proximity hint ---------------------------------------------------

# Whether survivors hear a chime coming from pages that are close by. The sound is
# played at the page's own position, so the client places it in 3D: a player hears
# which direction a page is in without ever being told where it is. The slender
# never hears it.
# How far a page can be heard is set per map, as proximityRange in its pages.json.
#pageProximityEnabled=true

# The sound played. A key that names no sound the server knows falls back to the
# default, so the hint never goes silent because of a typo.
#pageProximitySound=block.amethyst_block.chime
# How far past the map's proximityRange the chime's falloff is stretched. Between 1 and
# 8.
#
# Minecraft fades a sound to nothing at 16 * volume blocks, so a volume derived to
# reach exactly the range leaves the chime silent at the range's own edge - which
# is where the hint is meant to start being useful. This stretches the falloff
# past the range; what a player actually hears does not get wider, because the
# server drops pages outside the range before playing anything.
#
# 1 is the old behaviour. 2 leaves roughly half the volume at the edge of the
# range. Going much higher flattens the falloff until every page sounds equally
# close, which takes away the distance cue the 3D position is there for.
#pageProximityVolumeFactor=2.0

# --- Damage sound ----------------------------------------------------------

# Whether a player hears a sound when they take damage. Cygnus takes health off a
# survivor directly, which skips Minecraft's own hurt sound entirely, so without
# this a hit lands in silence.
#
# The sound plays on the hit player's own entity: only their client receives it,
# and it carries no direction. Where the hit came from is what the blood splatter
# is for. The slender never hears it - he is the only source of damage and would
# otherwise gain a second way to locate the survivor in front of him.
#damageSoundEnabled=true

# Ticks before the sound is played to the same player again. At least 1; 20 ticks
# is one second.
#
# A draining slender damages everyone around him twice a second, so this is what
# keeps continuous damage from turning into continuous noise. At the default of
# 20, every second damage tick is heard.
#damageSoundCooldown=20

# The sound played. A key that names no sound the server knows falls back to the
# default, so a hit never goes silent because of a typo.
#damageSound=entity.player.hurt

# --- Slender gaze ("glitch") -----------------------------------------------

# How badly the sight of the slender tears a survivor's view apart is decided per
# player, from their own position and where they are looking. Standing behind a
# survivor does nothing at all, however close he is.
#
# These three values are meant to be tuned against the resource pack. Note that a
# pack shipping a pinned test level overrides the whole decoding client-side - if
# the effect shows up regardless of what is set here, the pack is the place to
# look, not this file.

# How close he has to be before anything happens, in blocks. Between 1 and 64; a
# value outside that range is rejected and the service refuses to start.
#
# This is the outer edge, not the strongest point: at exactly this distance a
# survivor gets the weakest of the four levels, and it grows the nearer he comes.
# Beyond it there is nothing - no veil, and no darkening of the world.
#glitchRange=12

# The distance at which the tearing reaches its worst, in blocks. At least 1 and
# below glitchRange - a configuration where the two meet or cross is rejected,
# because the slope between them would run backwards or divide by zero.
#glitchCloseRange=4

# How far off the centre of their view he may stand and still count as seen, in
# degrees. Between 1 and 89.
#
# Deliberately narrower than the client's field of view: at 30 degrees he has to
# be in the middle of the screen, not at its edge. Widening this past roughly 50
# means he triggers the effect while barely in frame.
#glitchViewAngle=30

# --- The slender's page glitch -----------------------------------------------
# The survivors watch their page counter climb; the slender has none and only
# learns the score when the round ends. The glitch is that counter, told as his
# own picture coming apart (only while he is invisible): a baseline that climbs a level at a time as the pages
# disappear, and a harder pulse the moment one goes.
# It rides the same channel as the gaze glitch, so the resource pack draws it and
# the cygnus.overlays gate switches it off along with the other full-screen
# effects. Unlike the survivors' version it never darkens the world - that would
# take the sight the slender hunts with.

# Whether the slender's screen tears as his pages are collected.
#pageGlitchEnabled=true

# How long a single find holds the glitch one level above where the round stands,
# in seconds. Between 1 and 30. Past that a find late in the round would still be
# on screen when the next one lands, and the pulse stops reading as an event.
#pageGlitchPulseSeconds=3

# The strongest level the slender's screen may reach, baseline and pulse alike.
# Between 0 (the weakest) and 3 (the worst). Playtest: the higher levels left the
# slender blind to the survivors he is hunting, so he gets the weakest level only.
# With 0 his screen shows that level from the first page on and the pulse has no
# visible step above it. The glitch is only shown while the slender is invisible;
# while he is visible and hunting his screen is clean. Raise it to bring the climbing baseline and the pulse back.
#pageGlitchMaxLevel=0

# --- The lobby's atmosphere ---------------------------------------------------
# How far the lobby is taken from an open, well-lit sky towards the atmosphere of
# the map players are waiting for. Between 0 and 1.
#
# The point is the distance between the two. At 0 the lobby stays on the vanilla
# overworld, which is where it was, and the round starts as a cut: a player walks
# from a clear sky into fog that closes in at forty blocks, in the same moment the
# game begins. At 1 the lobby is the map exactly, and the start becomes invisible.
# In between, the lobby carries the map's own colours and haze at a distance the
# player can still see across, so the start reads as the world tightening.
#
# A map that declares no atmosphere has nothing to prepare anyone for; its lobby
# stays on the overworld regardless of this value.
#lobbyAtmosphereShare=0.3

# --- The creek --------------------------------------------------------------
# A second figure next to the slender, walked by the server. He wanders the map,
# stalks a single survivor late in the round, hunts them once the dread is high
# enough and punishes a catch - rarely by giving the survivor away to the slender.
# The creek only takes part on maps whose creek.json holds at least one usable
# route; everywhere else it stays away, even with creek.enabled=true.
# Every key below maps to a field of CreekConfig. An unreadable value falls back
# to its default; values that contradict each other are rejected.
# Distances that depend on the map (sight range, stalk distances, respawn distance,
# route link distance, personal space, launch height) are set per map in its creek.json.
#creek.enabled=true
#creek.activeWithLastSurvivor=true
#creek.stalkThreshold=0.25
#creek.huntThreshold=0.6
#creek.catchDistance=1.5
# A stalk only turns into a hunt once it has run for huntMinStalkSeconds, and
# never sooner than huntCooldownSeconds after the survivor's last hunt ended -
# however it ended. Keeps a caught survivor from being hunted again right away.
#creek.huntMinStalkSeconds=10
#creek.huntCooldownSeconds=45
# Speeds are in blocks per tick. A walking survivor covers about 0.216, so the
# hunt speed has to stay above that or a hunted survivor simply walks away.
#creek.wanderSpeed=0.07
#creek.huntSpeed=0.25
#creek.betrayalCatchCount=2
#creek.betrayalChance=0.15
# After reaching a waypoint the creek sometimes stops for a moment. The chance is
# between 0 and 1 (0 turns it off); the stop lasts between min and max milliseconds.
# A pause set on the route end in creek.json and a random stop do not add up: the
# longer one wins.
#creek.randomStopChance=0.15
#creek.randomStopMinMillis=1500
#creek.randomStopMaxMillis=4000
# On a catch the creek chooses one punishment on top of the usual ones: throw the
# caught survivor into the air (launchHeight in the map's creek.json), or swap places with another
# living survivor. This is the chance for the swap, between 0 and 1: 0 always
# throws, 1 always swaps. Without another survivor the creek throws instead.
# Playtest: tune this if the swaps happen too often or too rarely.
#creek.swapChance=0.5
# A survivor who was thrown loses this many health points when they land again
# (4.0 = two hearts). They are never killed by it: at least 1 health point stays.
# Between 0 and 20; 0 turns it off. A swap does no damage.
# Playtest: tune this if the landing hurts too much or too little.
#creek.launchDamage=4.0

# --- Sanity -----------------------------------------------------------------
# Every survivor has a fear value between 0 and 1. It jumps when they find a
# page, see the creek, get picked out or caught by it, or another survivor dies
# (anywhere on the map), and it grows steadily while a creek stalks them.
# It wears off again over time - but never below a floor. The floor grows with
# the pages found (pageFloorWeight) and the time played (timeFloorWeight), plus
# the share of every jump that never wears off (residualShare). The floor is
# capped at floorCap; keep that below creek.huntThreshold, so only a fresh scare
# starts a hunt.
# The creek reads it to decide whom to stalk (creek.stalkThreshold) and when to
# hunt (creek.huntThreshold). Players never see it; /creek shows it inverted as
# sanity (1 = calm, the lower the more scared).
# Every key below maps to a field of SanityConfig. An unreadable value falls back
# to its default; values out of range are rejected.
#sanity.pageFloorWeight=0.5
#sanity.pageFoundGain=0.10
#sanity.sightingGain=0.10
#sanity.sightingCooldownSeconds=20
#sanity.caughtGain=0.30
#sanity.selectedGain=0.15
#sanity.deathGain=0.25
#sanity.decayPerSecond=0.005
#sanity.stalkGainPerSecond=0.015
#sanity.residualShare=0.25
#sanity.timeFloorWeight=0.15
#sanity.floorCap=0.55

# --- Lure -------------------------------------------------------------------
# Once a survivor has died, a survivor who is on their own may see them standing
# in the distance, just outside their view, looking like a living player. Look at
# the figure for a moment and it is right in front of their face. After the scare
# a follow-up is rolled (slowness, a reveal on the slender's locator bar,
# blindness, or nothing), and the creek leaves the survivor alone for a while.
# One lure per survivor and round at most; a figure nobody noticed does not count.
# Every key below maps to a field of LureConfig. An unreadable value falls back
# to its default; values out of range are rejected.
#lure.enabled=true
# No other living survivor may be within this many blocks.
#lure.aloneRadius=30
# A lone survivor is rolled for every 5 seconds with this chance (0 to 1).
# Playtest: tune this if the lure comes too soon or too late.
#lure.rollChance=0.08
#lure.fearGain=0.30
# How long slowness, blindness or the reveal last, in seconds.
#lure.effectSeconds=4
# How long the creek leaves the survivor alone after the scare, in seconds.
#lure.respiteSeconds=60

# --- Stamina ----------------------------------------------------------------
# A survivor's sprint bar holds 20 points and drains 2 per second while they
# sprint. Once it ran dry, or once they stopped early, they may sprint again as
# soon as the bar is back at sprintResumeShare - not only when it is full.
# The slender cannot appear again for slenderReappearCooldownSeconds after he
# vanished, so he cannot chain one appearance onto the next. 0 turns it off.
# slenderDamageRange is how far around him the draining slender hurts survivors, in
# blocks, 1 to 16. Temporary playtest tuning: testers wanted more reach, so it went
# from 3 to 4. It stacks with the doubled damage per hit, so he now hurts more
# survivors for longer; lower it again if the rounds end too fast.
# Every key below maps to a field of StaminaConfig. An unreadable value falls
# back to its default; values out of range are rejected.
#stamina.sprintResumeShare=0.3
#stamina.regenPerSecond=1.25
#stamina.slenderReappearCooldownSeconds=5
#stamina.slenderDamageRange=4

# --- Adrenaline -------------------------------------------------------------
# A survivor who gets within adrenaline.radius blocks of the visible slender
# moves faster by adrenaline.speedBonus for adrenaline.durationSeconds and
# hears a heartbeat. After that, the same survivor waits
# adrenaline.cooldownSeconds before the next rush.
# Every key below maps to a field of AdrenalineConfig. An unreadable value
# falls back to its default; values out of range are rejected.
#adrenaline.radius=8
#adrenaline.speedBonus=0.2
#adrenaline.durationSeconds=4
#adrenaline.cooldownSeconds=20

# --- Footprints ---------------------------------------------------------------
# While hidden, the slender rolls footprint.slenderChance every
# footprint.slenderStepBlocks blocks. A hit leaves a print after a random delay
# between footprint.slenderDelayMinMillis and footprint.slenderDelayMaxMillis,
# which only survivors see and which fades within footprint.slenderLifetimeSeconds.
# Survivors leave a recorded point every footprint.survivorSampleBlocks blocks, kept
# for footprint.survivorHistorySeconds. The slender's tracker shows the points within
# footprint.scanRadius blocks, without the newest footprint.scanGapSeconds, at most
# footprint.scanMaxPrints prints for footprint.scanLifetimeSeconds, then waits
# footprint.scanCooldownSeconds. A single move longer than footprint.teleportBlocks
# is a teleport and counts as no walking. Revealed prints lie at least
# footprint.minSpacing blocks apart.
# For the last footprint.fadeShare of its lifetime a print shows its faded stage.
# Every key below maps to a field of FootprintConfig. An unreadable value
# falls back to its default. Values out of range are rejected.
#footprint.slenderStepBlocks=3.0
#footprint.slenderChance=0.25
#footprint.slenderDelayMinMillis=1000
#footprint.slenderDelayMaxMillis=2000
#footprint.slenderLifetimeSeconds=12
#footprint.survivorSampleBlocks=2.0
#footprint.survivorHistorySeconds=30
#footprint.scanRadius=40
#footprint.scanGapSeconds=5
#footprint.scanMaxPrints=40
#footprint.scanLifetimeSeconds=15
#footprint.scanCooldownSeconds=120
#footprint.teleportBlocks=8.0
#footprint.minSpacing=0.7
#footprint.fadeShare=0.33

# --- Telemetry --------------------------------------------------------------
# Cygnus creates OpenTelemetry traces: one per round with a child per phase, one per
# player join and kick, the startup and the shutdown. They only go anywhere when the
# opentelemetry-javaagent is attached to the JVM (-javaagent:opentelemetry-javaagent.jar,
# OTEL_SERVICE_NAME=cygnus, OTEL_EXPORTER_OTLP_ENDPOINT=...); without it every span is a
# no-op. See docs/telemetry.md.
#
# A span per tick would drown the backend, so ticks are only reported when one is slow.

# A server tick that takes at least this many milliseconds is reported as a
# cygnus.tick.slow span. At least 1; a smaller value is rejected and the service refuses
# to start. 50 is Minestom's tick budget, so the default flags every tick that ran over.
#telemetry.slowTickThresholdMillis=50

# --- Minimap ----------------------------------------------------------------
# Asks client minimap mods to switch themselves off, so nobody finds the slender or the
# pages on a radar. The request is a line of invisible colour codes in chat, sent after the
# player spawns and again whenever they spawn into another instance. OPT-IN ONLY: it is
# honoured by Xaero's Minimap / World Map and by VoxelMap (and mods using its codes), and
# ignored by modified clients and mods that do not know the convention. It can not be
# enforced and is no replacement for anti-cheat.
#
#   disabled  minimap off where the mod supports it (Xaero), plus radar and cave mode off.
#             VoxelMap has no "off" code, it only loses radar and cave mode.
#   fair      the map stays, radar and cave mode are asked to switch off.
#   off       nothing is sent.
#
# LabyMod 4 is asked, after it announces itself on labymod:neo, to deny entity_marker. It has
# no minimap or radar permission, so every mode but off sends the same thing.
#
# JourneyMap (current versions) is not covered: it is controlled by its own server mod.
# An unknown value is logged and replaced by the default.
#minimap.mode=disabled

# --- Client guard -----------------------------------------------------------
# Reads what the client says about itself: its brand (minecraft:brand) and the mod channels it
# registers (minecraft:register). A client that announces a known cheat client is logged and,
# in kick mode, disconnected. A modified client can leave out or fake both, so this catches
# the clients that do not bother to hide. It is not a replacement for anti-cheat.
#
#   off   nothing is checked.
#   log   a blocked client is logged once and allowed to stay.
#   kick  a blocked client is logged once and disconnected.
#
# blocked-brands: comma separated fragments. A brand containing one is blocked, so "meteor" also
#   catches "meteor-client". Case-insensitive. A blank value keeps the default list.
# blocked-channels: comma separated channel prefixes, case-insensitive. The default only covers
#   the World Downloader Mod (wdl:). Other cheat channels are not known to be stable yet, so
#   they are not guessed here; add them when verified. Minimap channels stay out of this list,
#   the minimap is handled by the minimap settings above.
# allowed-brands: optional whitelist of exact brands, for example "vanilla,fabric". Empty
#   (the default) lets every brand that is not blocked join. The whitelist judges a client once
#   it has named a brand; a client that never sends one is not kicked, since a silent client is
#   not caught by this check anyway.
#
# --- Shader probe ------------------------------------------------------------
# The shader probe asks each player's client, on the first spawn, which shader mods it has. These
# mods register no channel and no brand, so the probe makes the client show translatable texts
# that only they can translate: it opens a sign editor on a sign that exists for that one player
# only, and the answer shows which keys resolved. The sign editor is opened and closed by the
# server without any player input. The real instance is never changed.
#
# Caveats: blocker mods (ExploitPreventer, OpSec) answer with the fallbacks, so a client without
# any detected mod is not proof of a vanilla client. Iris is kicked even when no shader pack is
# active, since the server cannot see that. A client that does not answer within the timeout is
# not kicked. Other clients may react differently; closing the editor is what makes the client send
# its answer, see the Javadoc of ShaderModProbe.
#
# shader-probe: false turns the probe off, and no sign is sent to any client.
# incompatible-mods: shader mods whose presence kicks the client in kick mode and is logged in log
#   mode. Known ids: iris, optifine, canvas, sodium, embeddium, nvidium. Default: iris,optifine,canvas.
#   A mod listed here and in logged-mods counts as incompatible.
# logged-mods: shader mods that are only logged and recorded, never kicked. They only lose the
#   cosmetic terrain fog of the resource pack. Default: sodium,embeddium,nvidium.
#   An unknown id is logged and skipped. A blank list keeps the default; use shader-probe=false to
#   turn the probe off.
# shader-probe-timeout-ticks: server ticks a client has to answer one probe sign. A client that does
#   not answer in time is not judged, and the probe stops. Ticks, not seconds: 20 ticks are one
#   second. Default: 100. At least 1; anything lower falls back to the default.
#
# The kick message is "Incompatible mods detected!" in common/Messages.java.
#client-guard.shader-probe=true
#client-guard.incompatible-mods=iris,optifine,canvas
#client-guard.logged-mods=sodium,embeddium,nvidium
#client-guard.shader-probe-timeout-ticks=100
#
# An unknown mode is logged and replaced by the default (kick).
#client-guard.mode=kick
#client-guard.blocked-brands=meteor,wurst,aristois,liquidbounce,impact,future,rusherhack,inertia,bleachhack
#client-guard.blocked-channels=wdl:
#client-guard.allowed-brands=
# --- Client APIs ------------------------------------------------------------
# Courtesy requests to client mods through the server APIs they provide. A modified client can
# ignore them, so they are no anti-cheat and no replacement for one.
#
#   block-world-downloader   WorldDownloader is told on its init packet (wdl:init) to refuse all
#                            downloading of the world: no chunks, entities, tile entities or containers.
#                            Default: true
#   labymod-disabled-addons  comma separated LabyMod 4 addon namespaces that are force disabled for
#                            the player after LabyMod announces itself (AddonDisablePacket, id 24).
#                            Only lower case letters, digits, '.', '-' and '_' are accepted, other
#                            entries are logged and skipped. Default: empty, nothing is disabled.
#
#client-api.block-world-downloader=true
#client-api.labymod-disabled-addons=
# --- Lunar Client -----------------------------------------------------------
# Asks Lunar Client to switch off mods that could give a survivor an edge. Lunar Client takes
# the request over its Apollo API (channel lunar:apollo): once the client registers that channel,
# the server sends one ModSetting override per listed mod, setting the mod's "enabled" option to
# false. A client courtesy, not an anti-cheat: a modified client or another client ignores it.
#
#   disabled-mods  comma separated, from: minimap, waypoints, freelook, zoom, coordinates, directionhud.
#                  "none" switches off nothing. An unknown name is logged and skipped.
#   enabled        false turns the request off entirely.
#
# Unknown values are logged and replaced by the default.
#lunar.enabled=true
#lunar.disabled-mods=minimap,waypoints,freelook,zoom,coordinates,directionhud

# --- Slender pass -----------------------------------------------------------
# Passes are earned by playing and by a monthly rank quota (the LuckPerms meta
# cygnus.slender-pass.monthly-quota, once per UTC month in the lobby). Both need the statistics
# database, the same as the feature itself.
#
# pity-rounds  Survivor rounds played to the end until one pass is earned. At least 1.
# max-balance  The cap for earned passes: earning never lifts a balance above it. Administrator
#              changes are not capped. Zero or more.
#pass.pity-rounds=10
#pass.max-balance=5

# --- Statistics -------------------------------------------------------------
# Yearly player statistics. Every finished round is written to a PostgreSQL database: one row
# per player and round, plus one aggregate per player and calendar year. The schema is created
# by Flyway on start. All Cygnus servers of an environment may share one database.
#
# OFF unless a JDBC URL is set: nothing connects anywhere and the game runs as without it.
# The write happens after the round ended, off the tick thread; a failed write is logged and
# counted in the metric cygnus.stats.write.failures and never affects the round or the restart.
# Stored are the Minecraft UUID, game counters and the last known player name (so /stats can
# find offline players by name); the name is deleted together with the stats by UUID. No IPs.

# JDBC URL of the database.
#stats.jdbc-url=jdbc:postgresql://localhost:5432/cygnus

#stats.username=cygnus

# Leave it out to read the password from the environment variable CYGNUS_STATS_PASSWORD.
#stats.password=

# The database schema that holds the tables and Flyway's history. It is created on start and
# must not be 'public': that one belongs to the database's operator and Flyway refuses a
# non-empty schema without history. A lower-case SQL identifier ([a-z_][a-z0-9_]*, at most 63
# characters); an invalid value falls back to the default. The database user needs CREATE on
# the database (be its owner), or the schema must already exist and be owned by it.
#stats.schema=cygnus_stats

# Connections the pool may hold. At least 1.
#stats.pool-size=4

# The zone whose calendar decides which year a round counts for. A round that ends on
# New Year's Eve at 00:30 in this zone counts for the new year.
#stats.time-zone=Europe/Berlin
