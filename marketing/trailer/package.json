{
  "name": "cygnus-trailer",
  "private": true,
  "description": "Remotion-Trailer für den Cygnus-Spielmodus auf OneLiteFeather",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render:teaser": "remotion render CygnusTeaser out/cygnus-teaser-16x9.mp4",
    "render:short": "remotion render CygnusShort out/cygnus-short-9x16.mp4",
    "render:thumbnail": "remotion still CygnusThumbnail out/cygnus-thumbnail.png",
    "render:all": "npm run render:teaser && npm run render:short && npm run render:thumbnail",
    "sync-pack": "node scripts/sync-pack-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
